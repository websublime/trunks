# Settings for docker-compose.prod.yaml. Copy to `.env` and edit; `.env` is git-ignored.

# Password of the `trunks` PostgreSQL role (only reachable inside the compose network).
POSTGRES_PASSWORD=

# Where people and MCP clients reach Trunks, as seen from outside (your reverse proxy).
TRUNKS_PUBLIC_URL=https://trunks.example.com
TRUNKS_ALLOWED_HOSTS=trunks.example.com

# Single sign-on (optional) — also uncomment the three lines in docker-compose.prod.yaml.
# TRUNKS_OIDC_ISSUER=https://idp.example.com/realms/main
# TRUNKS_OIDC_CLIENT_ID=trunks
# TRUNKS_OIDC_CLIENT_SECRET=
