---
// The Trunks mark: a shield with a tree, teal to violet.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <defs>
    <linearGradient id="trunks-mark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#12a594"></stop>
      <stop offset="1" stop-color="#6e56cf"></stop>
    </linearGradient>
  </defs>
  <path
    d="M12 2.5 4 5.5v6c0 4.6 3.4 8.4 8 9.9 4.6-1.5 8-5.3 8-9.9v-6z"
    fill="none"
    stroke="url(#trunks-mark)"
    stroke-width="1.75"
    stroke-linejoin="round"></path>
  <path
    d="M12 17.5v-9M12 12l-3-2.5M12 10.5l3-2.5M12 14l2.5-2"
    fill="none"
    stroke="url(#trunks-mark)"
    stroke-width="1.75"
    stroke-linecap="round"></path>
</svg>
