---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
---

<Shell title="Page not found">
  <section class="panel">
    <div class="state">
      <Icon name="alert" class="ic-xl" />
      <h1 class="ttl">Page not found</h1>
      <p>There is no page at this address. It may have been renamed, or the link is wrong.</p>
      <a class="btn" href="/">Go to the overview</a>
    </div>
  </section>
</Shell>
